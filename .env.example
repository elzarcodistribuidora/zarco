# --- Supabase (Postgres + Auth) ---
# Dashboard → Project Settings → API.
# NEXT_PUBLIC_SUPABASE_URL: SIN /rest/v1/ ni diagonal final
#   (https://gekuyrjsehwsyorqyuxc.supabase.co). Un sufijo mal puesto da el
#   error "No API key found".
NEXT_PUBLIC_SUPABASE_URL=
# anon/publishable key — se incrusta en el build → al cambiarla hay que redeploy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service-role key — SOLO servidor (/api/quote, scripts de import). Bypassea
# RLS: nunca exponerla al navegador ni prefijarla con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Revalidación on-demand del catálogo (/api/revalidate) ---
# La dispara un webhook externo (o el panel admin) cuando cambia un precio.
# Inventa un token largo. Se manda preferentemente como header
# `x-revalidate-token: TU_TOKEN`; también se acepta `?token=TU_TOKEN` en la
# query por compatibilidad, pero esa forma queda expuesta en logs de acceso —
# usa el header en integraciones nuevas.
APPS_SCRIPT_TOKEN=

# --- Flouvia / Cord (cotizaciones desde el panel admin) ---
# Usado por /api/cord/create (requiere sesión de admin). Sin esto, ese botón
# del panel responde 500.
CORD_SECRET_KEY=

# --- Sitio (para SEO/sitemap/Open Graph) ---
# URL pública del sitio. En local puede quedar en localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
