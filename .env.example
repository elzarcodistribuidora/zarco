# --- Auth.js ---
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=

# --- Google OAuth (login de clientes) ---
# Reutiliza el OAuth client que YA tienes en Google Cloud:
#   Client ID: 655792493975-...apps.googleusercontent.com
# Falta el Client Secret (Google Cloud > Credentials > ese OAuth client).
# Y agrega estos redirect URIs a ese client:
#   http://localhost:3000/api/auth/callback/google
#   https://TU-DOMINIO/api/auth/callback/google   (cuando despleguemos)
AUTH_GOOGLE_ID=655792493975-nji5od4bj90955qdesbi3ls5l0o3hpe9.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=

# --- La Matriz (Google Apps Script Web App = tu backend actual de Sheets) ---
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxw90vbv7D4jNGhOgryf8oj3imRFsiYFVboyWaNbCYS-qC8SnrWzdK-BrDGuNqKxtCZHQ/exec
# Token compartido para blindar getUserSession y los POST (pedidos). Inventa
# uno largo y ponlo TAMBIÉN en el Apps Script (ver snippet en CLAUDE.md).
# Si lo dejas vacío, no se manda token (comportamiento actual).
APPS_SCRIPT_TOKEN=

# --- Sitio (para SEO/sitemap/Open Graph) ---
# URL pública del sitio. En local puede quedar en localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
